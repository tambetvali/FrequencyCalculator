type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_2 = 
 variant {
   err: Error;
   ok;
 };
type Result_1 = 
 variant {
   err: NotebookError;
   ok;
 };
type Result = 
 variant {
   err: NotebookError;
   ok: NotebookEntryView;
 };
type Order = nat;
type NotebookError = 
 variant {
   notAuthorized;
   notFound: EntryId;
 };
type NotebookEntryView = 
 record {
   body: text;
   conceptId: ConceptId;
   createdAt: Timestamp;
   id: EntryId;
   order: Order;
   title: text;
   updatedAt: Timestamp;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type EntryId = nat;
type ConceptId = text;
type Concept = 
 record {
   id: ConceptId;
   name: text;
   page: text;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_2);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  /// Create a notebook entry owned by the signed-in caller.
  createNotebookEntry: (title: text, body: text, conceptId: ConceptId, order:
   Order) -> (EntryId);
  /// Delete one of the caller's own entries.
  deleteNotebookEntry: (id: EntryId) -> (Result_1);
  execute: (qJson: text) -> (Result__1) query;
  /// The backend's public API, as Markdown.
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  isCallerAdmin: () -> (bool) query;
  /// The canonical concept index: ids, display names, and owning page.
  listConcepts: () -> (vec Concept) query;
  /// List the signed-in caller's own notebook entries.
  listNotebookEntries: () -> (vec NotebookEntryView) query;
  schema: () -> (text) query;
  /// Update one of the caller's own entries.
  updateNotebookEntry: (id: EntryId, title: text, body: text, conceptId:
   ConceptId, order: Order) -> (Result);
}
